# 복사해서 .env 로 쓰세요. (서버 시작 시 자동으로 읽습니다)

# 서버 포트
PORT=3000

# DB 파일과 업로드 이미지가 저장되는 폴더. 호스팅을 옮길 때는 이 값만 바꾸면 됩니다.
DATA_DIR=./data

# 최초 관리자 계정 (DB에 관리자가 없을 때 시작 시 한 번 생성됩니다)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# 프로필 이미지 최대 용량(MB)
MAX_IMAGE_MB=2

# 채팅 도배 제한: N초 안에 M개까지
CHAT_RATE_WINDOW_SEC=10
CHAT_RATE_MAX=6

# 로그인/가입 시도 제한: IP당 5분에 허용하는 횟수
AUTH_RATE_MAX=15

# 3단계 (선택)
# ROUND_DEADLINE_SEC=90   # 전투 라운드 제한 시간(초)
# ROUND_MIN_SEC=10        # 행동을 골라도 최소 이만큼은 기다림(그 사이 채팅·응원)
# QUESTS_FILE=            # 다른 의뢰 파일 경로 (기본 content/quests.json)
# RNG_SEED=               # 주사위 고정(테스트 전용, 운영에서는 비워두세요)
